# Copy to .env.local and fill in.

# The WhatsApp number orders are sent to, digits only with country code.
# Deliberately NOT prefixed NEXT_PUBLIC_: that would compile it into every page
# and expose it to the scrapers that harvest wa.me links. /wa attaches it
# server-side at redirect time instead.
WHATSAPP_NUMBER=919000000000

# Password for the Owner Studio at /admin.
ADMIN_PASSWORD=choose-a-strong-password

# Secret used to sign the admin session cookie. Generate a fresh random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=paste-a-long-random-string-here

# Your site's public address, once you have a domain. Used for product links,
# WhatsApp/Instagram link previews and the sitemap. No trailing slash.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Hosting (leave all of these unset for local development) ---
# With TURSO_DATABASE_URL set, the app uses hosted Turso instead of the local
# SQLite file. See DEPLOY.md.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# With BLOB_READ_WRITE_TOKEN set, admin photo uploads go to Vercel Blob instead
# of public/uploads. Vercel adds this for you when you create a Blob store.
# BLOB_READ_WRITE_TOKEN=...

# Optional. Where the local SQLite file lives; defaults to data/store.db.
# Ignored when TURSO_DATABASE_URL is set.
# DATABASE_PATH=data/store.db
